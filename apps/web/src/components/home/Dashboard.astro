---
/**
 * Owner-portal mock-up. All figures are placeholders and the component is
 * visibly labelled "Illustrative interface" — it must never show real client data.
 */
import Icon from '../Icon.astro';
import { getDict } from '~/i18n';
import type { Locale } from '~/i18n/config';
interface Props { locale: Locale }
const t = getDict(Astro.props.locale);
const d = t.home.control.dashboard;
const bars = [38, 52, 61, 74, 88, 96, 92, 81, 64, 47, 35, 30];
---
<div class="dash glass" data-tilt aria-label={t.common.common.illustrative} role="img">
  <div class="dash-top">
    <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <span class="tag">{t.common.common.illustrative}</span>
  </div>
  <div class="dash-head">
    <strong>{d.title}</strong>
    <span class="pill">{d.period}</span>
  </div>
  <div class="kpis">
    <div class="kpi"><span>{d.revenue}</span><b dir="ltr">€ ••,•••</b></div>
    <div class="kpi"><span>{d.expenses}</span><b dir="ltr">€ •,•••</b></div>
    <div class="kpi kpi--accent"><span>{d.net}</span><b dir="ltr">€ ••,•••</b></div>
  </div>
  <div class="chart" aria-hidden="true">
    {bars.map((h, i) => <span style={`--h:${h}%;--i:${i}`}></span>)}
  </div>
  <div class="dash-rows">
    <div class="row"><Icon name="calendar" size={18} /><span>{d.next}</span><em dir="ltr">••/••</em></div>
    <div class="row"><Icon name="wrench" size={18} /><span>{d.taskA}</span><em class="ok">{d.statusDone}</em></div>
    <div class="row"><Icon name="wrench" size={18} /><span>{d.taskB}</span><em class="wait">{d.statusOpen}</em></div>
    <div class="row"><Icon name="file" size={18} /><span>{d.report}</span><em class="ok"><Icon name="check" size={16} /></em></div>
  </div>
</div>

<style>
  .dash { padding: 1.25rem; display: grid; gap: 1.1rem; transition: transform 0.5s var(--ease-out); transform-style: preserve-3d; box-shadow: 0 40px 100px rgba(0, 0, 0, 0.45); background: rgba(34, 31, 48, 0.72); }
  .dash-top { display: flex; justify-content: space-between; align-items: center; }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); }
  .tag { font-family: var(--font-label); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); border: 1px solid rgba(255, 190, 17, 0.4); padding: 0.25rem 0.55rem; border-radius: 999px; }
  .dash-head { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-display); font-size: 1.1rem; }
  .pill { font-size: 0.78rem; padding: 0.3rem 0.7rem; border-radius: 999px; background: rgba(255, 255, 255, 0.08); color: var(--text-inverse-muted); }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  .kpi { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 14px; padding: 0.75rem; display: grid; gap: 0.25rem; }
  .kpi span { font-size: 0.72rem; color: var(--text-inverse-muted); line-height: 1.3; }
  .kpi b { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; letter-spacing: -0.02em; }
  .kpi--accent { background: linear-gradient(135deg, rgba(103, 84, 233, 0.5), rgba(103, 84, 233, 0.15)); border-color: rgba(176, 167, 239, 0.35); }
  .chart { height: 120px; display: flex; align-items: flex-end; gap: 6px; padding: 0.5rem 0.25rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .chart span { flex: 1; height: var(--h); border-radius: 6px 6px 2px 2px; background: linear-gradient(180deg, var(--lavender), var(--violet)); opacity: 0.85; transform-origin: bottom; animation: grow 1.4s var(--ease-out) both; animation-delay: calc(var(--i) * 60ms); }
  @keyframes grow { from { transform: scaleY(0.05); } }
  .dash-rows { display: grid; gap: 0.35rem; }
  .row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.7rem; padding: 0.6rem 0.75rem; border-radius: 12px; background: rgba(255, 255, 255, 0.04); font-size: 0.875rem; }
  .row :global(svg) { color: var(--lavender); }
  .row em { font-style: normal; font-size: 0.78rem; color: var(--text-inverse-muted); }
  .row em.ok { color: #7ee2b8; }
  .row em.wait { color: var(--gold); }
</style>
