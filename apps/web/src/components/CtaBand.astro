---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { IMAGES } from '~/lib/images';
import { getDict } from '~/i18n';
import { localizePath, type Locale } from '~/i18n/config';
import { COMPANY } from '~/lib/company';
interface Props { locale: Locale; title?: string; body?: string }
const { locale } = Astro.props;
const t = getDict(locale);
const c = t.home.cta;
const title = Astro.props.title ?? c.title;
const body = Astro.props.body ?? c.body;
---
<section class="section cta-band">
  <div class="container">
    <div class="cta-card section--dark grain" data-reveal="scale">
      <div class="cta-bg" aria-hidden="true">
        <Image src={IMAGES['villa-pool'].src} alt="" widths={[640, 1280]} sizes="(min-width: 1280px) 1280px, 100vw" />
      </div>
      <div class="cta-content relative">
        <p class="eyebrow">{c.eyebrow}</p>
        <h2 class="h-1" data-split>{title}</h2>
        <p class="lead">{body}</p>
        <div class="btn-row">
          <a href={localizePath('/contact/', locale)} class="btn btn--light">{c.button}<Icon name="arrow" size={18} class="arrow" /></a>
          <a href={`tel:${COMPANY.phone}`} class="btn btn--glass"><Icon name="phone" size={18} /><span dir="ltr">{COMPANY.phoneDisplay}</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: calc(var(--section) * 0.5) var(--section); }
  .cta-card { position: relative; overflow: hidden; border-radius: var(--radius-xl); padding: clamp(2rem, 1rem + 5vw, 6rem); isolation: isolate; }
  .cta-bg { position: absolute; inset: 0; z-index: -1; }
  .cta-bg :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }
  .cta-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(18, 15, 36, 0.96) 25%, rgba(67, 48, 184, 0.55)); }
  :global([dir='rtl']) .cta-bg::after { background: linear-gradient(260deg, rgba(18, 15, 36, 0.96) 25%, rgba(67, 48, 184, 0.55)); }
  .cta-content { display: grid; gap: 1.25rem; max-width: 720px; }
  .cta-content .btn-row { margin-top: 0.75rem; }
</style>
