---
import { getDict } from '~/i18n';
import { localizePath, type Locale } from '~/i18n/config';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getDict(locale).common.cookie;
---
<div class="cookie glass-light" role="dialog" aria-live="polite" aria-label={c.more} hidden data-cookie>
  <p>{c.text} <a href={localizePath('/legal/cookie-policy/', locale)}>{c.more}</a></p>
  <div class="btn-row">
    <button type="button" class="btn btn--sm btn--ghost" data-consent="essential">{c.decline}</button>
    <button type="button" class="btn btn--sm" data-consent="analytics">{c.accept}</button>
  </div>
</div>

<style>
  .cookie {
    position: fixed; z-index: 70; inset-inline-start: var(--gutter); inset-inline-end: var(--gutter); bottom: var(--gutter); max-width: 440px; margin-inline-start: auto;
    padding: 1rem 1.15rem; display: grid; gap: 0.8rem; font-size: 0.85rem; color: var(--ink);
    box-shadow: 0 24px 60px rgba(18, 15, 36, 0.18);
  }
  .cookie a { color: var(--violet); text-decoration: underline; text-underline-offset: 3px; }
  .cookie .btn--ghost { color: var(--ink); }
</style>

<script>
  // Consent state lives in localStorage ("sm-consent" = essential | analytics).
  // Analytics scripts must only be injected after `sm:consent` fires with "analytics".
  const el = document.querySelector<HTMLElement>('[data-cookie]');
  let stored: string | null = null;
  try { stored = localStorage.getItem('sm-consent'); } catch {}
  if (el && !stored) el.hidden = false;
  el?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => {
      const v = b.dataset.consent || 'essential';
      try { localStorage.setItem('sm-consent', v); } catch {}
      el.hidden = true;
      window.dispatchEvent(new CustomEvent('sm:consent', { detail: v }));
    }),
  );
</script>
