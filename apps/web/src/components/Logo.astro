---
/**
 * Brand logo. If the official files exist in public/brand/ they are used:
 *   logo-on-light.svg|png  (dark logo, for light backgrounds)
 *   logo-on-dark.svg|png   (white logo, for dark backgrounds)
 * Otherwise this falls back to the interim wordmark below.
 */
import fs from 'node:fs';
import path from 'node:path';
interface Props { class?: string; tone?: 'auto' | 'light' | 'dark' }
const { class: cls, tone = 'auto' } = Astro.props;
const brandDir = path.resolve('public/brand');
const pick = (base: string) => ['svg', 'png', 'webp'].map((e) => `${base}.${e}`).find((f) => fs.existsSync(path.join(brandDir, f)));
const onLight = pick('logo-on-light');
const onDark = pick('logo-on-dark');
const official = onLight && onDark;
---
{official ? (
  <span class:list={['logo-official', `tone-${tone}`, cls]}>
    <img class="on-light" src={`/brand/${onLight}`} alt="Sivan Management" width="170" height="50" />
    <img class="on-dark" src={`/brand/${onDark}`} alt="" aria-hidden="true" width="170" height="50" />
  </span>
) : (
<span class:list={['logo', cls]} aria-label="Sivan Management">
  <svg class="logo-mark" viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
    <defs>
      <linearGradient id="lg-mark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#8b7bf3" />
        <stop offset="1" stop-color="#4330b8" />
      </linearGradient>
    </defs>
    <rect width="40" height="40" rx="12" fill="url(#lg-mark)" />
    <path d="M12 26.5c1.6 1.6 4.3 2.6 7.6 2.6 4.4 0 7.4-2 7.4-5.2 0-3-2.3-4.3-6.6-5l-2.4-.4c-2.4-.4-3.4-1-3.4-2.2 0-1.4 1.6-2.4 4.1-2.4 2.3 0 4.2.8 5.6 2" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" />
    <circle cx="29" cy="11" r="2.2" fill="#ffbe11" />
  </svg>
  <span class="logo-word" aria-hidden="true">
    <span class="logo-name">Sivan</span>
    <span class="logo-sub">Management</span>
  </span>
</span>
)}

<style>
  .logo-official { display: inline-flex; align-items: center; direction: ltr; }
  .logo-official img { height: 42px; width: auto; }
  .logo-official .on-dark { display: none; }
  :global(.is-overlay:not(.is-scrolled)) .logo-official .on-light, :global(.section--ink) .logo-official .on-light, .tone-dark .on-light { display: none; }
  :global(.is-overlay:not(.is-scrolled)) .logo-official .on-dark, :global(.section--ink) .logo-official .on-dark, .tone-dark .on-dark { display: block; }
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; direction: ltr; }
  .logo-mark { flex: none; filter: drop-shadow(0 6px 14px rgba(103, 84, 233, 0.35)); }
  .logo-word { display: flex; flex-direction: column; line-height: 1; }
  .logo-name { font-family: 'Inter Tight Variable', system-ui, sans-serif; font-weight: 650; font-size: 1.28rem; letter-spacing: -0.04em; }
  .logo-sub { font-family: 'Syne', 'Inter Tight Variable', sans-serif; font-weight: 700; font-size: 0.58rem; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.7; margin-top: 0.2rem; }
</style>
