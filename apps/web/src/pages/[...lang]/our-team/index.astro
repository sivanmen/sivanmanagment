---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { getDict } from '~/i18n';
import { localePaths, localizePath, type Locale } from '~/i18n/config';
import { COMPANY } from '~/lib/company';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const t = getDict(locale);
const tm = t.about.team;
const icons = ['compass', 'home', 'heart', 'chart', 'wrench', 'building', 'users', 'sparkle', 'file'];
// Founder portrait: place an approved photo at public/team/sivan-menahem.jpg (4:5) and set this to its path.
const founderPhoto: string | null = null;
---
<BaseLayout locale={locale} path="/our-team/" title={tm.seoTitle} description={tm.seoDescription}>
  <PageHero locale={locale} eyebrow={tm.eyebrow} title={tm.title} lead={tm.lead} crumbs={[{ label: t.common.nav.team }]} />

  <section class="section">
    <div class="container founder">
      <div class="portrait" data-reveal="scale">
        {founderPhoto
          ? <img src={founderPhoto} alt={COMPANY.founder} width="800" height="1000" loading="lazy" />
          : <div class="monogram" aria-hidden="true"><span>SM</span></div>}
      </div>
      <div class="stack" style="--stack:1.1rem">
        <p class="eyebrow" data-reveal="fade">{tm.founderRole}</p>
        <h2 class="h-1" data-split>{COMPANY.founder}</h2>
        <p class="lead" data-reveal>{tm.founderBio}</p>
        <div class="btn-row" data-reveal>
          <a class="btn" href={localizePath('/contact/', locale)}>{t.common.common.talkToTeam}<Icon name="arrow" size={18} class="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="head">
        <h2 class="h-2" data-split>{tm.departmentsTitle}</h2>
        <p class="lead" data-reveal>{tm.departmentsLead}</p>
      </div>
      <div class="grid grid-3">
        {tm.departments.map((d, i) => (
          <div class="card dept" data-reveal style={`--d:${(i % 3) * 80}ms`}>
            <span class="icon-badge"><Icon name={icons[i]} /></span>
            <h3 class="h-3">{d.title}</h3>
            <p class="muted">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand locale={locale} title={tm.joinTitle} body={tm.joinBody} />
</BaseLayout>

<style>
  .founder { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .founder { grid-template-columns: 0.8fr 1.2fr; gap: 5rem; } }
  .portrait { aspect-ratio: 4 / 5; border-radius: var(--radius-xl); overflow: hidden; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .monogram { width: 100%; height: 100%; display: grid; place-items: center; background: radial-gradient(120% 90% at 20% 10%, #8b7bf3, var(--violet-700) 55%, var(--night)); }
  .monogram span { font-family: var(--font-display); font-weight: 600; font-size: clamp(5rem, 3rem + 8vw, 10rem); letter-spacing: -0.06em; color: rgba(255, 255, 255, 0.92); }
  .head { display: grid; gap: 1rem; max-width: 760px; margin-bottom: 3rem; }
  .dept { display: grid; gap: 0.85rem; align-content: start; }
</style>
